# Flask Secret Key for session signing and CSRF
FLASK_SECRET_KEY=dev-secret-key-change-in-production-12345

# Google Gemini API Key (Leave empty to use automatic rule-based fallback mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database URL
DATABASE_URL=sqlite:///finance.db

# Default Currency Symbol (₹, $, €, £)
DEFAULT_CURRENCY=₹
